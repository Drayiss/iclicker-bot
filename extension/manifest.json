{
  "manifest_version": 3,
  "name": "iClicker Bot — Experimental Monitor",
  "version": "1.3.1",
  "description": "Pairs a selected iClicker tab with your local PC app. Checks every three seconds.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "debugger", "alarms", "notifications"],
  "host_permissions": ["https://student.iclicker.com/*", "http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "iClicker Bot"},
  "icons": {"128": "icon.png"}
}
